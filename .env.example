# Frontend only: Next.js reads .env.local; this origin is compiled at build time.
# Local default is http://127.0.0.1:8000, so no setting is needed locally.
# Vercel requires the actual persistent backend's public HTTPS origin.
# CLIPFORGE_API_ORIGIN=https://your-backend.example.com

# Backend only: set these in the backend host's environment (Uvicorn does not
# automatically read the frontend's .env.local).
# CLIPFORGE_DATA=/var/lib/zyntracut
# CLIPFORGE_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-domain.example
# CLIPFORGE_COOKIE_SECURE=true
# CLIPFORGE_RENDER_WORKERS=1
# CLIPFORGE_FAST_BATCH_SIZE=1
# WHISPER_MODEL=base
# WHISPER_ROMAN_MODEL=small
# WHISPER_HINDI_MODEL=small
# ESPEAK_NG_BINARY=/usr/bin/espeak-ng
# CLIPFORGE_TRANSLATION_MODELS=/var/lib/zyntracut/translations

# Never commit authentication tokens, private restore keys or real .env files.
